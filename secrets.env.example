# Copy to .env and keep it private (chmod 600 .env).
# Generate a hash on Debian with: mkpasswd -m sha-512
ROOT_PASSWORD_HASH='$6$CHANGE_ME'
# Embedded in the prepared ISOs; use a long random value and protect the ISOs.
ANSWER_TOKEN='installer:CHANGE_ME_RANDOM_SECRET'
# Reachable from the installation VLAN. DHCP is required only to fetch the answer.
ANSWER_URL='https://192.0.2.100:8080/answer'
# Generated by scripts/generate_tls_certificate.sh
TLS_CERT='/absolute/path/to/tls/answer-server.crt'
TLS_KEY='/absolute/path/to/tls/answer-server.key'
ANSWER_CERT_FINGERPRINT='CHANGE_ME_SHA256_FINGERPRINT'
