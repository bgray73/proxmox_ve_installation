RUN_AS_USER nut
MONITOR ups-a@<PVE01-LAN-IP> 1 monitor-secondary <SECONDARY-PASSWORD> secondary
MONITOR ups-b@<PVE01-LAN-IP> 1 monitor-secondary <SECONDARY-PASSWORD> secondary
MINSUPPLIES 1
SHUTDOWNCMD "/sbin/shutdown -h now"
POLLFREQ 5
POLLFREQALERT 5
HOSTSYNC 15
DEADTIME 15
FINALDELAY 5
NOTIFYFLAG ONLINE SYSLOG+WALL
NOTIFYFLAG ONBATT SYSLOG+WALL
NOTIFYFLAG LOWBATT SYSLOG+WALL
NOTIFYFLAG FSD SYSLOG+WALL
NOTIFYFLAG NOCOMM SYSLOG+WALL
# UPS output power-off is intentionally not enabled by this pack.
